# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - QUẢN LÝ KÝ TÚC XÁ CÔNG NHÂN
# ============================================================================

# 1. Gemini AI API Key (Chỉ sử dụng ở backend server.ts, không lộ ra frontend)
GEMINI_API_KEY=

# 2. URL ứng dụng
APP_URL=

# 3. Cấu hình Supabase (Postgres & Storage)
# VITE_SUPABASE_URL và VITE_SUPABASE_ANON_KEY dùng cho phía client (Frontend)
# LƯU Ý: Frontend CHỈ sử dụng Anon Key (khóa công khai có kiểm soát Row Level Security - RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 4. SUPABASE_SERVICE_ROLE_KEY CHỈ DÙNG CHO SCRIPT MIGRATION TRONG TERMINAL (BACKEND CLI)
# ⚠️ CẢNH BÁO BẢO MẬT: TUYỆT ĐỐI KHÔNG ĐỂ SERVICE_ROLE KEY TRONG FRONTEND!
# KHÔNG ĐẶT TIỀN TỐ VITE_ VÀ KHÔNG SỬ DỤNG TRONG MÃ NGUỒN REACT / TRÌNH DUYỆT.
SUPABASE_SERVICE_ROLE_KEY=

# 5. Cấu hình Firebase đối soát & Migration dữ liệu (Chỉ dùng cho script terminal)
FIREBASE_PROJECT_ID=basic-tribute-rt8c4
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
