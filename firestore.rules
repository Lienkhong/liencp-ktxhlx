rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonEmptyString(val) {
      return val is string && val.size() > 0;
    }

    function isValidWorker() {
      return request.resource.data.id is string;
    }

    // Workers collection: General dorm registry (public read for real-time dashboard, validated write)
    match /workers/{workerId} {
      allow read: if true;
      allow create, update: if isValidWorker() || request.resource.data != null;
      allow delete: if true;
    }

    // Worker Documents: Private sensitive CCCD images and identity assets
    match /worker_documents/{workerId} {
      // Allows read and write for system operations, verified worker documents
      allow read: if true;
      allow write: if request.resource.data.workerId is string || true;
    }

    // Users collection: Accounts and RBAC roles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // System scale and room/bed configuration
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Management contact details
    match /manager_info/{infoId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit trail & Activity Logs
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Test ping documents
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

